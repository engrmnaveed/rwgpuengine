{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slate.dev/schema/scene.json",
  "title": "slate scene file",
  "type": "object",
  "description": "A level: ground, entities and the connections between their signals.",
  "properties": {
    "scene": {
      "type": "object",
      "description": "Scene metadata.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name. Default: the file name."
        },
        "doc": {
          "type": "string",
          "description": "What the scene is for."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "Overrides the project seed for this scene."
        }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "description": "What part of the world is on screen.",
      "properties": {
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Grid point [x, y] at the middle of the frame. Default: the middle of the ground."
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Extra shift in screen pixels [right, down]. Default: [0, 0]."
        }
      },
      "additionalProperties": false
    },
    "ground": {
      "type": "object",
      "description": "A rectangle of floor cells; also the bounds movers stay inside.",
      "properties": {
        "size": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Number of cells [x, y]."
        },
        "color": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Floor color. Default: \"#6fa86a\"."
        },
        "alt_color": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Color of every other cell. Default: `color`, slightly darker."
        }
      },
      "required": ["size"],
      "additionalProperties": false
    },
    "entity": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A thing in the world. Starts from an optional prefab; keys here override it (component tables merge key by key).",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_/-]+$",
            "description": "Unique name, needed to reference it from [[connect]], playtests and `inspect --entity`."
          },
          "prefab": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_/-]+$",
            "description": "Prefab to start from: `wall` loads prefabs/wall.toml."
          },
          "pos": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 3,
            "description": "Grid position [x, y] or [x, y, z]. +x is down-right on screen, +y is down-left, z is up. Default: [0, 0, 0]."
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 1,
            "description": "Place one copy on each listed cell instead of `pos`. Cannot be used with `name`."
          },
          "enabled": {
            "type": "boolean",
            "description": "Disabled entities are not drawn, not solid, cannot be tapped and run no behaviors. Default: true."
          },
          "solid": {
            "type": "boolean",
            "description": "Nothing can move into its cell. Default: false."
          },
          "tile": {
            "type": "object",
            "description": "Flat diamond on the floor (marks, pressure plates).",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                "description": "Fill color. Default: \"#c9b26b\"."
              }
            },
            "additionalProperties": false
          },
          "block": {
            "type": "object",
            "description": "Isometric box (walls, crates, buildings).",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                "description": "Top face color. Default: \"#9aa0a6\"."
              },
              "height": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 64.0,
                "description": "Height in z units. Default: 1.0."
              }
            },
            "additionalProperties": false
          },
          "sprite": {
            "type": "object",
            "description": "Upright shape standing on the cell (characters, items).",
            "properties": {
              "shape": {
                "enum": ["circle", "rect", "diamond"],
                "description": "circle (ellipse filling size), rect or diamond. Default: \"circle\"."
              },
              "color": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                "description": "Fill color. Default: \"#ffffff\"."
              },
              "size": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "Width and height in pixels. Default: [24, 32]."
              },
              "offset": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "description": "Shift in pixels [right, down] from the standing point. Default: [0, 0]."
              }
            },
            "additionalProperties": false
          },
          "mover": {
            "type": "object",
            "description": "Moves one cell per direction input.",
            "properties": {
              "step_frames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600,
                "description": "Frames from one move to the next. `hold` for `step_frames × N` frames gives exactly N steps. Default: 8."
              }
            },
            "additionalProperties": false
          },
          "patrol": {
            "type": "object",
            "description": "Walks a fixed path of cells.",
            "properties": {
              "path": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 1,
                "description": "Cells to visit, in order."
              },
              "step_frames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6000,
                "description": "Frames between steps. Default: 30."
              },
              "mode": {
                "enum": ["loop", "pingpong"],
                "description": "loop: back to the first cell; pingpong: walk the path backwards. Default: \"loop\"."
              }
            },
            "required": ["path"],
            "additionalProperties": false
          },
          "wander": {
            "type": "object",
            "description": "Walks randomly (seeded).",
            "properties": {
              "step_frames": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6000,
                "description": "Frames between steps. Default: 45."
              },
              "area": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 1,
                "description": "Two corner cells [[x0, y0], [x1, y1]] to stay inside. Default: the whole ground."
              }
            },
            "additionalProperties": false
          },
          "trigger": {
            "type": "object",
            "description": "Emits signals when actors step on or off its cell.",
            "properties": {
              "on_enter": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_/-]+$",
                "description": "Signal emitted when the cell becomes occupied. Default: \"pressed\"."
              },
              "on_exit": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_/-]+$",
                "description": "Signal emitted when the cell becomes empty. Default: \"released\"."
              },
              "only": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_/-]+$",
                "description": "Only this entity (by name) counts. Default: any actor."
              }
            },
            "additionalProperties": false
          },
          "props": {
            "type": "object",
            "additionalProperties": {
              "type": ["boolean", "integer", "number", "string"]
            },
            "description": "Free-form game data, shown by `inspect` and readable from Rust."
          }
        },
        "additionalProperties": false
      },
      "description": "Things in the world, one `[[entity]]` table each."
    },
    "connect": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "When entity `from` emits `signal`, apply `action` to entity `to`. Every entity emits `tapped` when tapped.",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_/-]+$",
            "description": "Name of the emitting entity."
          },
          "signal": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_/-]+$",
            "description": "Signal name, e.g. `pressed`, `released`, `tapped`."
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_/-]+$",
            "description": "Name of the target entity."
          },
          "action": {
            "enum": ["enable", "disable", "toggle"],
            "description": "enable, disable or toggle the target."
          }
        },
        "required": ["from", "signal", "to", "action"],
        "additionalProperties": false
      },
      "description": "Signal wiring, one `[[connect]]` table each."
    }
  },
  "additionalProperties": false
}
