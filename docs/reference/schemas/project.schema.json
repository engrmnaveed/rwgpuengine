{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slate.dev/schema/project.json",
  "title": "slate slate.toml",
  "type": "object",
  "description": "Project settings. Its folder is the project root; every path in the project is relative to it.",
  "properties": {
    "project": {
      "type": "object",
      "description": "Name and entry scene.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name."
        },
        "engine": {
          "type": "string",
          "description": "slate version the project targets, e.g. \"0.1\". `check` warns (W0205) if the running slate differs."
        },
        "main_scene": {
          "type": "string",
          "description": "Scene used when a command is given no scene. Default: \"scenes/main.toml\"."
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "description": "Output size and background.",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "description": "Frame width in pixels. Default: 640."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096,
          "description": "Frame height in pixels. Default: 480."
        },
        "background": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Color behind everything. Default: \"#1d2330\"."
        }
      },
      "additionalProperties": false
    },
    "iso": {
      "type": "object",
      "description": "Isometric grid geometry.",
      "properties": {
        "tile_width": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1024,
          "description": "Diamond width in pixels. Usually 2 × tile_height. Default: 64."
        },
        "tile_height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 512,
          "description": "Diamond height in pixels. Default: 32."
        },
        "z_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024,
          "description": "Pixels per unit of height (z, block height). Default: 32."
        }
      },
      "additionalProperties": false
    },
    "sim": {
      "type": "object",
      "description": "Simulation rate and seed.",
      "properties": {
        "tick_rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Steps per second. Default: 60."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807,
          "description": "Seed for all randomness. Playtests and `--seed` can override it. Default: 1."
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["project"],
  "additionalProperties": false
}
